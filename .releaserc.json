{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    ["@semantic-release/commit-analyzer", { "preset": "conventionalcommits" }],
    ["@semantic-release/release-notes-generator", { "preset": "conventionalcommits" }],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "dotnet pack ShkoOnline.EarlyBound.slnx -c Release -p:ContinuousIntegrationBuild=true -p:Version=${nextRelease.version}",
        "publishCmd": "dotnet nuget push \"artifacts/package/release/*.${nextRelease.version}.nupkg\" --source https://api.nuget.org/v3/index.json --api-key \"$NUGET_API_KEY\" --skip-duplicate"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [{ "path": "artifacts/package/release/*.nupkg", "label": "NuGet package" }]
      }
    ]
  ]
}
