<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests for the plug-ins. Account, Sho_Project and the other table classes are not generated
    here: they come from Contoso.Plugins, with the members the plug-ins use. What a test needs
    beyond those is generated here, in classes derived from them: AccountTestEntity : Account.
  -->
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <RootNamespace>Contoso.Plugins.Tests</RootNamespace>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Use the plug-in project's earlybound.yaml and Metadata folder. -->
    <EarlyBoundMetadataRoot>..\Contoso.Plugins</EarlyBoundMetadataRoot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Contoso.Plugins\Contoso.Plugins.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.60" />
    <PackageReference Include="ShkoOnline.EarlyBound" Version="$(EarlyBoundVersion)" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
  </ItemGroup>

</Project>
