<Project Sdk="Microsoft.NET.Sdk">

  <!-- A modern .NET app that shares the plug-in project's metadata instead of keeping a copy. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Contoso.Console</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- No metadata of its own: the files come from the plug-in project below. -->
    <EnableDefaultEarlyBoundItems>false</EnableDefaultEarlyBoundItems>
    <!-- The Dataverse client still references packages with published advisories. Pin patched versions in real projects. -->
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.PowerPlatform.Dataverse.Client" Version="1.2.27" />
    <PackageReference Include="ShkoOnline.EarlyBound" Version="$(EarlyBoundVersion)" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <EarlyBoundMetadata Include="..\Contoso.Plugins\earlybound.yaml" />
    <EarlyBoundMetadata Include="..\Contoso.Plugins\Metadata\**\*.yaml" />
  </ItemGroup>

</Project>
