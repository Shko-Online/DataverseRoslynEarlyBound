<Project Sdk="Microsoft.NET.Sdk">

  <!-- A Dataverse plug-in assembly: .NET Framework 4.6.2 and the C# 7.3 that comes with it. -->
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <RootNamespace>Contoso.Plugins</RootNamespace>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.60" />
    <PackageReference Include="ShkoOnline.EarlyBound" Version="$(EarlyBoundVersion)" PrivateAssets="all" />
  </ItemGroup>

</Project>
