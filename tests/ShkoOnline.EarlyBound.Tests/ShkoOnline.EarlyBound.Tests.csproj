<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>ShkoOnline.EarlyBound.Tests</RootNamespace>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" />
    <!-- The real SDK, so generated code is compiled against what consumers reference. -->
    <PackageReference Include="Microsoft.PowerPlatform.Dataverse.Client" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ShkoOnline.EarlyBound.Core\ShkoOnline.EarlyBound.Core.csproj" />
    <ProjectReference Include="..\..\src\ShkoOnline.EarlyBound.Generator\ShkoOnline.EarlyBound.Generator.csproj" />
    <ProjectReference Include="..\..\src\ShkoOnline.EarlyBound.Completion\ShkoOnline.EarlyBound.Completion.csproj" />
    <ProjectReference Include="..\..\src\ShkoOnline.EarlyBound.Tool\ShkoOnline.EarlyBound.Tool.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
