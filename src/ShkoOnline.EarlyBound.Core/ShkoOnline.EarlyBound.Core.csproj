<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>ShkoOnline.EarlyBound</RootNamespace>
    <Description>Metadata model, YAML format, naming and C# emitter shared by Shko Online's Early Bound generator, autocomplete provider and CLI.</Description>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="PolySharp" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources/CamelCaseDictionary.txt" LogicalName="ShkoOnline.EarlyBound.CamelCaseDictionary.txt" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ShkoOnline.EarlyBound.Tests" />
  </ItemGroup>

</Project>
